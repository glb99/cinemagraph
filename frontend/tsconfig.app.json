{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    // No baseUrl: "paths" resolve relative to this file, which is what
    // "./src/*" already meant. Dropped rather than kept because TypeScript 7
    // removes the option outright, and nothing here needed it.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
